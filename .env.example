# Leave Supabase values empty to run in Local Demo Mode (no cross-device sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Private (authorized) realtime channels. Requires supabase/schema.sql to be applied.
# Set to "false" only for debugging; public channels are guessable-ID-only protection.
VITE_REALTIME_PRIVATE=true

# WebRTC (screen share / voice / webcam). STUN is free; TURN is needed for strict NATs.
VITE_STUN_URLS=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
